{
  "name": "pedia-safe-actions",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "db:find": "rg 'from '@/lib/db'|@prisma|pg|next/headers' src/components",
    "find": "bun run find.ts",
    "clean": "bun run clean:cache && bun run clean:build && bun run clean:deps",
    "clean:all": "bun run clean && bun run clean:prisma",
    "clean:build": "rimraf **/dist **/.tsbuildinfo",
    "clean:cache": "rimraf .next node_modules/.cache **/.turbo **/.vercel",
    "clean:deps": "rimraf **/node_modules bun.lock",
    "clean:prisma": "rimraf prisma/migrations && bun prisma migrate reset --force",
    "ui:remove": "bunx  shadcn@canary remove",
    "db:admin": "bun run ./prisma/admin.ts  --watch",
    "ui:add": "bunx shadcn@latest add ",
    "analyze": "next experimental-analyze",
    "check": "biome check --write",
    "auth:gen": "bunx @better-auth/cli generate --config ./src/lib/auth/index.ts",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "db:introspect": "bun prisma db pull",
    "db:seed": "prisma db seed",
    "db:reset": "prisma migrate reset --force",
    "db:format": "prisma format",
    "inspect": "NODE_OPTIONS='--inspect' next dev",
    "lint:fix": "biome check . --write --unsafe",
    "db:generate": "prisma generate",
    "dev": "next dev",
    "typecheck": "NODE_OPTIONS='--max-old-space-size=8192' tsc --noEmit --emitDeclarationOnly false",
    "build": "next build",
    "start": "next start",
    "lint": "biome check",
    "format": "biome format --write"
  },
