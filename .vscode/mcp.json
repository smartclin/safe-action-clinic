{
    "mcpServers": {
        "next-devtools": {
            "command": "npx",
            "args": ["-y", "next-devtools-mcp@latest"]
        },
        "better-auth": {
            "url": "https://mcp.chonkie.ai/better-auth/better-auth-builder/mcp"
        },
        "prisma": {
            "command": "npx",
            "args": ["-y", "prisma", "mcp"]
        },
        "shadcn": {
            "command": "npx",
            "args": ["shadcn@latest", "mcp"]
        },
        "shadcn-ui": {
            "command": "bunx",
            "args": ["@jpisnice/shadcn-ui-mcp-server"]
        }
    }
}
